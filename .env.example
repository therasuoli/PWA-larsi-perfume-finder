# Larsi Perfume Finder — environment template
# Copy to `.env` (or set as GitHub Actions secrets / Supabase secrets) and fill in.
# NEVER commit the actual `.env` file. Only publishable keys go in the browser.

# ─── Browser-side (safe to ship, public) ────────────────────────────────────
# These are also hardcoded in js/config.js because the browser has no .env access.
# Both values come from your Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://eixzihvihoammvremxrl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Server-side only (NEVER ship to the browser) ──────────────────────────
# Use these only in Edge Functions or GitHub Actions. The browser MUST NOT see them.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://eixzihvihoammvremxrl.supabase.co/auth/v1/.well-known/jwks.json

# Owner password for bank-upload Edge Function (Supabase Secret — set with `supabase secrets set`)
BANK_UPLOAD_PASSWORD=replace-with-a-long-random-string

# GitHub Actions only (for pushing back to the repo)
# Generate at: https://github.com/settings/tokens → fine-grained PAT with Contents:Write
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pages base URL for the SEO rebuild (no trailing slash issues — the script adds one)
PAGES_BASE_URL=https://therasuoli.github.io/PWA-larsi-perfume-finder/
